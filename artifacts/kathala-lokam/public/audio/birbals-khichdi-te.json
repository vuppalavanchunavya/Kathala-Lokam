{
 "voice": "te-IN-ShrutiNeural",
 "duration": 86.06,
 "sentences": [
  {
   "scene": 1,
   "text": "అది ఒక చల్లని సాయంత్రం.",
   "start": 0.05,
   "end": 2.87
  },
  {
   "scene": 1,
   "text": "అక్బర్ మహారాజు, బీర్బల్ సరస్సు పక్కన నడుస్తున్నారు.",
   "start": 2.87,
   "end": 7.6
  },
  {
   "scene": 1,
   "text": "అక్బర్ అడిగాడు, “బహుమతి కోసం ఎవరైనా రాత్రంతా చల్లని నీళ్లలో నిలబడగలరా?” దగ్గరలో ఉన్న ఒక పేదవాడు ఆ మాట విన్నాడు.",
   "start": 7.6,
   "end": 17.91
  },
  {
   "scene": 1,
   "text": "మహారాజా, నేను ప్రయత్నిస్తాను.",
   "start": 17.91,
   "end": 21.3
  },
  {
   "scene": 1,
   "text": "మా ఇంట్లో వాళ్లకి డబ్బు చాలా అవసరం,” అన్నాడు.",
   "start": 21.3,
   "end": 24.89
  },
  {
   "scene": 2,
   "text": "ఆ రాత్రంతా అతను సరస్సులో నిలబడ్డాడు.",
   "start": 25.01,
   "end": 28.78
  },
  {
   "scene": 2,
   "text": "దూరంగా ఒక దీపం వెలుగుతోంది.",
   "start": 28.78,
   "end": 31.98
  },
  {
   "scene": 2,
   "text": "అతను దాన్నే చూస్తూ ఉండిపోయాడు.",
   "start": 31.98,
   "end": 35.19
  },
  {
   "scene": 2,
   "text": "తెల్లారాక అక్బర్‌కి ఆ విషయం తెలిసింది.",
   "start": 35.19,
   "end": 38.91
  },
  {
   "scene": 2,
   "text": "ఓహో!",
   "start": 38.91,
   "end": 40.45
  },
  {
   "scene": 2,
   "text": "దీపం వెచ్చదనమే నిన్ను కాపాడింది.",
   "start": 40.45,
   "end": 43.87
  },
  {
   "scene": 2,
   "text": "బహుమతి ఇవ్వను,” అన్నాడు.",
   "start": 43.87,
   "end": 45.98
  },
  {
   "scene": 3,
   "text": "బీర్బల్‌కి ఇది నచ్చలేదు.",
   "start": 46.11,
   "end": 48.91
  },
  {
   "scene": 3,
   "text": "అతను చాలా రోజులు సభకి రాలేదు.",
   "start": 48.91,
   "end": 52.39
  },
  {
   "scene": 3,
   "text": "ఒక రోజు అక్బర్ అతని ఇంటికి వెళ్ళాడు.",
   "start": 52.39,
   "end": 55.99
  },
  {
   "scene": 3,
   "text": "అక్కడ ఒక పాత్ర చాలా ఎత్తున వేలాడుతోంది.",
   "start": 55.99,
   "end": 60.01
  },
  {
   "scene": 3,
   "text": "దాని కింద చిన్న మంట మాత్రమే ఉంది.",
   "start": 60.01,
   "end": 63.52
  },
  {
   "scene": 3,
   "text": "అక్బర్ నవ్వి, “ఇంత ఎత్తులో కిచిడీ ఎలా ఉడుకుతుంది?” అన్నాడు.",
   "start": 63.52,
   "end": 68.94
  },
  {
   "scene": 3,
   "text": "బీర్బల్ నవ్వుతూ, “మహారాజా, దూరంలో ఉన్న దీపం సరస్సు నీళ్లని వెచ్చగా చేయగలిగితే, ఈ మంట కిచిడీని ఎందుకు ఉడికించదు?” అన్నాడు.",
   "start": 68.94,
   "end": 79.67
  },
  {
   "scene": 3,
   "text": "అక్బర్‌కి తన తప్పు అర్థమైంది.",
   "start": 79.67,
   "end": 82.78
  },
  {
   "scene": 3,
   "text": "ఆ పేదవాడికి ఇవ్వాల్సిన బహుమతిని ఇచ్చేశాడు.",
   "start": 82.78,
   "end": 85.99
  }
 ]
}